    "global-probe-table": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "refId": "A",
                  "query": {
                    "datasource": {
                      "name": "dfkh6j26t6gw0c"
                    },
                    "group": "influxdb",
                    "kind": "DataQuery",
                    "spec": {
                      "query": "allProbes = from(bucket: v.defaultBucket)\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"qoe_probe_run\")\n  |> filter(fn: (r) => r._field == \"run_duration_ms\")\n  |> group(columns: [\"probe_id\", \"site\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, probe_id: r.probe_id, site: r.site, _value: 0.0, dur: r._value}))\n\nactiveProbes = from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"qoe_probe_run\")\n  |> filter(fn: (r) => r._field == \"run_duration_ms\")\n  |> group(columns: [\"probe_id\", \"site\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, probe_id: r.probe_id, site: r.site, _value: 1.0, dur: r._value}))\n\nunion(tables: [allProbes, activeProbes])\n  |> group(columns: [\"probe_id\", \"site\"])\n  |> sort(columns: [\"_value\"], desc: true)\n  |> first()\n  |> map(fn: (r) => ({\n      \"Sonda\": r.probe_id,\n      \"Sitio\": r.site,\n      \"Estado\": if r._value == 1.0 then \"Activa\" else \"Inactiva\",\n      \"Ultimo Reporte\": string(v: r._time),\n      \"Duracion ms\": r.dur\n    }))\n  |> group()\n  |> sort(columns: [\"Sitio\", \"Sonda\"])",
                      "range": false
                    },
                    "version": "v0"
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
