[Unit]
Description=CX-Radar QoE Monitoring Probe Action
After=network.target

[Service]
Type=oneshot
# Adjust this to match your repository directory
WorkingDirectory=/absolute/path/to/CX-RADAR
# Path to your python interpreter and probe script
ExecStart=/usr/bin/python3 scripts/qoe_probe.py --config-path config/probe-catalog.json
# Option to pass the token via environment variable here or in a separate file
Environment=INFLUXDB_TOKEN=your-token-value-here
# Optional: EnvironmentFile=/absolute/path/to/CX-RADAR/.env

[Install]
WantedBy=default.target
