{
  "probe": {
    "probeId": "eduardo-pc-trabajo",
    "probeType": "python",
    "site": "home-office",
    "environment": "production",
    "probeVersion": "0.2.0",
    "isp": "Inter"
  },
  "influx": {
    "baseUrl": "https://us-east-1-1.aws.cloud2.influxdata.com",
    "org": "cx-radar",
    "bucket": "qoe_metrics",
    "precision": "ms",
    "writeTimeoutSeconds": 30,
    "tokenEnvVar": "INFLUXDB_TOKEN",
    "credentialFilePath": "%LOCALAPPDATA%\\CX-Radar\\secrets\\influxdb-token.credential.xml"
  },
  "probeRun": {
    "connectTimeoutSeconds": 10,
    "maxTimeSeconds": 120,
    "retryCount": 1,
    "retryDelaySeconds": 2,
    "startJitterSecondsMax": 15,
    "targetDelayMilliseconds": 750,
    "followRedirects": true,
    "verifyTls": true,
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "logDirectory": "logs",
    "measurement": "qoe_http_check",
    "probeMeasurement": "qoe_probe_run",
    "realMetricsMeasurement": "qoe_real_metrics",
    "speedTestTimeoutSeconds": 420,
    "portableTools": {
      "nodeExe": "bin\\node\\node.exe",
      "fastCliScript": "bin\\fast-cli\\node_modules\\fast-cli\\distribution\\cli.js",
      "ytDlpExe": "bin\\yt-dlp.exe",
      "puppeteerCacheDir": "bin\\puppeteer-cache",
      "temporaryDirectory": "bin\\tmp"
    },
    "throughputEngine": "timed",
    "downloadDurationSeconds": 8,
    "uploadDurationSeconds": 6,
    "warmupSeconds": 2
  },
  "targets": [
    {
      "service": "Microsoft",
      "endpointName": "microsoft-100mb-test",
      "type": "speedtest",
      "speedTestMethod": "burst",
      "uploadMeasurementMethod": "curl-upload",
      "host": "download.microsoft.com",
      "downloadUrl": "https://download.microsoft.com/download/8/4/A/84A35BF1-DAFE-4AE8-82AF-AD2AE20B6B14/directx_Jun2010_redist.exe",
      "targetTransferBytes": 33554432,
      "parallelConnections": 8,
      "uploadPayloadBytes": 33554432,
      "maxDownloadIterations": 4,
      "enabled": true
    },
    {
      "service": "Youtube",
      "endpointName": "video-4k-stress",
      "type": "speedtest",
      "speedTestMethod": "yt-dlp",
      "uploadMeasurementMethod": "curl-upload",
      "host": "www.youtube.com",
      "videoUrl": "https://www.youtube.com/watch?v=LXb3EKWsInQ",
      "format": "bestvideo+bestaudio/best",
      "parallelConnections": 8,
      "uploadPayloadBytes": 33554432,
      "enabled": true
    },
    {
      "service": "Netflix",
      "endpointName": "nflx-video-cdn",
      "type": "speedtest",
      "speedTestMethod": "fast-api",
      "host": "fast.com",
      "enabled": true,
      "uploadMeasurementMethod": "oca",
      "parallelConnections": 8,
      "urlCount": 5,
      "ocaHostFilter": "telemic"
    },
    {
      "service": "Disney+",
      "endpointName": "disney-open-asset",
      "type": "speedtest",
      "speedTestMethod": "burst",
      "uploadMeasurementMethod": "curl-upload",
      "host": "vod-bgc-na-east-1.media.dssott.com",
      "downloadUrl": "https://vod-bgc-na-east-1.media.dssott.com/ps01/disney/bgui/2025/11/19/1763572017-national-geographic.mp4",
      "targetTransferBytes": 33554432,
      "parallelConnections": 8,
      "uploadPayloadBytes": 33554432,
      "maxDownloadIterations": 14,
      "enabled": true,
      "downloadUrls": [
        "https://vod-bgc-na-east-1.media.dssott.com/ps01/disney/bgui/2025/11/19/1763572017-national-geographic.mp4",
        "https://vod-bgc-na-east-1.media.dssott.com/ps01/disney/bgui/2025/11/19/1763572081-pixar.mp4",
        "https://vod-bgc-na-east-1.media.dssott.com/ps01/disney/bgui/2025/11/19/1763572428-star-wars.mp4",
        "https://vod-bgc-na-east-1.media.dssott.com/ps01/disney/bgui/2025/11/19/1763568616-disney.mp4",
        "https://vod-bgc-na-east-1.media.dssott.com/ps01/disney/bgui/2025/11/19/1763568825-marvel.mp4",
        "https://vod-bgc-na-east-1.media.dssott.com/ps01/disney/bgui/2025/11/19/1763572191-xyz.mp4"
      ]
    },
    {
      "service": "Amazon",
      "endpointName": "aws-large-asset",
      "type": "speedtest",
      "speedTestMethod": "burst",
      "uploadMeasurementMethod": "curl-upload",
      "host": "m.media-amazon.com",
      "downloadUrl": "https://m.media-amazon.com/images/G/01/video/METI_2026_Trailer_15s_Legends_Post_Draper_16x9_Stereo_Final_en-US_.mp4",
      "targetTransferBytes": 33554432,
      "parallelConnections": 8,
      "uploadPayloadBytes": 33554432,
      "maxDownloadIterations": 3,
      "enabled": true
    },
    {
      "service": "Inter-Ookla-Barquisimeto",
      "endpointName": "ookla-38816-bqto",
      "type": "speedtest",
      "speedTestMethod": "ookla-http",
      "host": "speedtest.bqto.inter.com.ve",
      "ooklaHost": "speedtest.bqto.inter.com.ve",
      "ooklaPort": 8080,
      "ooklaServerId": 38816,
      "parallelConnections": 8,
      "enabled": true
    },
    {
      "service": "Inter-Ookla-Caracas",
      "endpointName": "ookla-37714-ccs",
      "type": "speedtest",
      "speedTestMethod": "ookla-http",
      "host": "speedtest.ccs.inter.com.ve",
      "ooklaHost": "speedtest.ccs.inter.com.ve",
      "ooklaPort": 8080,
      "ooklaServerId": 37714,
      "parallelConnections": 8,
      "enabled": true
    }
  ],
  "heartbeat": {
    "failThreshold": 2,
    "recoverThreshold": 2,
    "samplesPerTarget": 5,
    "timeoutSeconds": 2,
    "maxLatencyMs": {
      "inter": 40,
      "external": 150
    },
    "maxLossPercentage": 20,
    "targets": [
      {
        "name": "inter-ookla-bqto",
        "host": "speedtest.bqto.inter.com.ve",
        "port": 8080,
        "kind": "inter"
      },
      {
        "name": "inter-ookla-ccs",
        "host": "speedtest.ccs.inter.com.ve",
        "port": 8080,
        "kind": "inter"
      },
      {
        "name": "cloudflare",
        "host": "1.1.1.1",
        "port": 443,
        "kind": "external"
      },
      {
        "name": "google",
        "host": "www.google.com",
        "port": 443,
        "kind": "external"
      },
      {
        "name": "netflix",
        "host": "fast.com",
        "port": 443,
        "kind": "external"
      }
    ],
    "dnsNames": [
      "www.google.com",
      "www.youtube.com",
      "www.netflix.com"
    ]
  },
  "onuReport": {
    "minOnusPerPon": 5,
    "newOfflineAbsolute": 6,
    "newOfflineMin": 4,
    "newOfflineRatio": 0.3,
    "rxDropDb": 2.0,
    "mostlyOfflineRatio": 0.5,
    "maxTelegramItems": 15,
    "snapshotRetentionDays": 30
  }
}
