      "global-kpi-probes": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "datasource": {
                        "name": "dfkh6j26t6gw0c"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "hb = from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"qoe_heartbeat_status\" and r._field == \"status_code\")\n  |> group(columns: [\"probe_id\", \"site\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, probe_id: r.probe_id, site: r.site, _value: 1.0}))\n\nrun = from(bucket: v.defaultBucket)\n  |> range(start: -40m)\n  |> filter(fn: (r) => r._measurement == \"qoe_probe_run\" and r._field == \"run_duration_ms\")\n  |> group(columns: [\"probe_id\", \"site\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, probe_id: r.probe_id, site: r.site, _value: 1.0}))\n\nactiveProbes = union(tables: [hb, run])\n  |> group(columns: [\"probe_id\", \"site\"])\n  |> last()\n\nactiveProbes\n  |> group()\n  |> count()\n  |> map(fn: (r) => ({_time: now(), _field: \"Sondas Activas\", _value: float(v: r._value)}))\n  |> group(columns: [\"_field\"])",
                        "range": false
                      },
                      "version": "v0"
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
